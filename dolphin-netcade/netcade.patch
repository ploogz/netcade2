+// Copyright 2026 Netcade contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <SFML/Network/TcpSocket.hpp>
+#include <picojson.h>
+
+#include "Common/CommonTypes.h"
+
+// Link to the Netcade launcher, which runs NetPlay sessions on Dolphin's behalf.
+//
+// Netcade listens on 127.0.0.1:<port> and starts Dolphin with --netcade-control=<port> (and the
+// session token in the NETCADE_TOKEN environment variable). Both sides exchange one JSON object
+// per line:
+//   Dolphin -> Netcade: {"ev": "hello" | "state" | "msg" | "started" | "stopped" | ...}
+//   Netcade -> Dolphin: {"cmd": "start" | "pads" | "buffer" | "options" | "show" | ...}
+//
+// Commands are delivered on the bridge's own thread; the owner moves them to the UI thread.
+class NetcadeBridge
+{
+public:
+  using CommandHandler = std::function<void(picojson::object)>;
+  using StatusHandler = std::function<void(bool connected)>;
+
+  NetcadeBridge(u16 port, std::string token, CommandHandler on_command, StatusHandler on_status);
+  ~NetcadeBridge();
+
+  NetcadeBridge(const NetcadeBridge&) = delete;
+  NetcadeBridge& operator=(const NetcadeBridge&) = delete;
+
+  // Safe to call from any thread. Dropped silently while not connected.
+  void Send(const picojson::object& message);
+  bool IsConnected() const { return m_connected; }
+
+private:
+  void Run();
+  bool SendLine(const std::string& line);
+
+  const u16 m_port;
+  const std::string m_token;
+  CommandHandler m_on_command;
+  StatusHandler m_on_status;
+
+  sf::TcpSocket m_socket;
+  std::mutex m_send_mutex;
+  std::atomic<bool> m_running{true};
+  std::atomic<bool> m_connected{false};
+  std::thread m_thread;
+};
