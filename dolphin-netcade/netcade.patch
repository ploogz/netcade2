+void MainWindow::StartNetcadeSession(const std::string& game_path, bool host, u16 control_port,
+                                     const std::string& token)
+{
+  if (control_port != 0)
+  {
+    m_netplay_dialog->EnableNetcade(control_port, token);
+    setWindowState(windowState() | Qt::WindowMinimized);
+  }
+
+  // Dolphin decides who "has the game" by looking in its game list once, when a player joins, so
+  // wait until our copy is listed (up to 30 seconds on a first, uncached scan).
+  auto game = std::make_shared<const UICommon::GameFile>(game_path);
+  auto* timer = new QTimer(this);
+  auto attempts = std::make_shared<int>(0);
+  connect(timer, &QTimer::timeout, this, [this, timer, game, attempts, host] {
+    bool listed = false;
+    if (game->IsValid())
+    {
+      const auto& model = m_game_list->GetGameListModel();
+      for (int i = 0; i < model.rowCount(QModelIndex()) && !listed; ++i)
+      {
+        listed = model.GetGameFile(i)->CompareSyncIdentifier(game->GetSyncIdentifier()) ==
+                 NetPlay::SyncIdentifierComparison::SameGame;
+      }
+    }
+    if (!listed && game->IsValid() && ++*attempts < 120)
+      return;
+
+    timer->stop();
+    timer->deleteLater();
+    if (!game->IsValid())
+      m_netplay_dialog->NetcadeNotify("failed", "unreadable-game");
+    else if (!listed)
+      m_netplay_dialog->NetcadeNotify("gameNotListed");
+
+    if (host && !game->IsValid())
+      return;
+    const bool ok = host ? NetPlayHost(*game) : NetPlayJoin();
+    if (!ok)
+      m_netplay_dialog->NetcadeNotify("failed", host ? "host" : "join");
+  });
+  timer->start(250);
+}
