+// ---------------------------------------------------------------------------------- Netcade
+
+namespace
+{
+const char* NetcadeStatusName(NetPlay::SyncIdentifierComparison status)
+{
+  switch (status)
+  {
+  case NetPlay::SyncIdentifierComparison::SameGame:
+    return "ok";
+  case NetPlay::SyncIdentifierComparison::DifferentHash:
+    return "wrongHash";
+  case NetPlay::SyncIdentifierComparison::DifferentDiscNumber:
+    return "wrongDisc";
+  case NetPlay::SyncIdentifierComparison::DifferentRevision:
+    return "wrongRevision";
+  case NetPlay::SyncIdentifierComparison::DifferentRegion:
+    return "wrongRegion";
+  case NetPlay::SyncIdentifierComparison::DifferentGame:
+    return "missing";
+  default:
+    return "unknown";
+  }
+}
+
+std::string GetString(const picojson::object& object, const char* key)
+{
+  const auto it = object.find(key);
+  return it != object.end() && it->second.is<std::string>() ? it->second.get<std::string>() : "";
+}
+}  // namespace
+
+void NetPlayDialog::EnableNetcade(u16 control_port, const std::string& token)
+{
+  m_netcade = std::make_unique<NetcadeBridge>(
+      control_port, token,
+      [this](picojson::object command) {
+        QueueOnObject(this, [this, command = std::move(command)] { OnNetcadeCommand(command); });
+      },
+      [this](bool connected) {
+        QueueOnObject(this, [this, connected] {
+          m_netcade_lost = !connected;
+          if (connected)
+          {
+            SendNetcadeState();
+          }
+          else if (Settings::Instance().GetNetPlayClient() && !isVisible())
+          {
+            // Netcade is gone: hand the session back to the player
+            QDialog::show();
+            raise();
+          }
+        });
+      });
+}
+
+bool NetPlayDialog::IsNetcadeHidden() const
+{
+  return m_netcade && !m_netcade_lost;
+}
+
+void NetPlayDialog::NetcadeNotify(const std::string& event, const std::string& detail)
+{
+  if (!m_netcade)
+    return;
+  picojson::object message;
+  message["ev"] = picojson::value(event);
+  if (!detail.empty())
+    message["detail"] = picojson::value(detail);
+  m_netcade->Send(message);
+}
+
+void NetPlayDialog::SendNetcadeState()
+{
+  if (!m_netcade)
+    return;
+  const auto client = Settings::Instance().GetNetPlayClient();
+  const auto server = Settings::Instance().GetNetPlayServer();
+  if (!client)
+    return;
+
+  const NetPlay::PadMappingArray& pads = client->GetPadMapping();
+  picojson::array players;
+  for (const NetPlay::Player* player : client->GetPlayers())
+  {
+    double port = 0;
+    for (std::size_t i = 0; i < pads.size(); ++i)
+    {
+      if (pads[i] == player->pid)
+      {
+        port = static_cast<double>(i + 1);
+        break;
+      }
+    }
+    picojson::object entry;
+    entry["pid"] = picojson::value(static_cast<double>(player->pid));
+    entry["name"] = picojson::value(player->name);
+    entry["ping"] = picojson::value(static_cast<double>(player->ping));
+    entry["revision"] = picojson::value(player->revision);
+    entry["status"] = picojson::value(NetcadeStatusName(player->game_status));
+    entry["port"] = picojson::value(port);
+    entry["host"] = picojson::value(player->IsHost());
+    players.emplace_back(entry);
+  }
+
+  std::string savedata = "none";
+  if (m_savedata_load_and_write_action->isChecked())
+    savedata = "write";
+  else if (m_savedata_load_only_action->isChecked())
+    savedata = "load";
+  std::string network_mode = "fixeddelay";
+  if (m_host_input_authority_action->isChecked())
+    network_mode = "hostinputauthority";
+  else if (m_golf_mode_action->isChecked())
+    network_mode = "golf";
+
+  picojson::object options;
+  options["savedata"] = picojson::value(savedata);
+  options["syncAllWii"] = picojson::value(m_savedata_all_wii_saves_action->isChecked());
+  options["syncCodes"] = picojson::value(m_sync_codes_action->isChecked());
+  options["strictSync"] = picojson::value(m_strict_settings_sync_action->isChecked());
+  options["recordInputs"] = picojson::value(m_record_input_action->isChecked());
+  options["networkMode"] = picojson::value(network_mode);
+  options["golfOverlay"] = picojson::value(m_golf_mode_overlay_action->isChecked());
+  options["hideRemoteGbas"] = picojson::value(m_hide_remote_gbas_action->isChecked());
+
+  picojson::object state;
+  state["ev"] = picojson::value("state");
+  state["hosting"] = picojson::value(server != nullptr);
+  state["players"] = picojson::value(players);
+  state["buffer"] = picojson::value(static_cast<double>(m_buffer_size_box->value()));
+  state["hostInputAuthority"] = picojson::value(m_host_input_authority);
+  state["running"] = picojson::value(Core::IsRunning(Core::System::GetInstance()));
+  state["optionsEditable"] = picojson::value(server != nullptr && m_start_button->isEnabled());
+  state["game"] = picojson::value(m_current_game_name);
+  state["windowVisible"] = picojson::value(isVisible());
+  state["options"] = picojson::value(options);
+  m_netcade->Send(state);
+}
+
+std::string NetPlayDialog::NetcadeStartGame(bool force)
+{
+  const auto client = Settings::Instance().GetNetPlayClient();
+  const auto server = Settings::Instance().GetNetPlayServer();
+  if (!client || !server)
+    return "not-host";
+  if (!m_start_button->isEnabled())
+    return "already-running";
+  if (!force && !client->DoAllPlayersHaveGame())
+    return "not-all-have-game";
+  if (m_strict_settings_sync_action->isChecked() && Config::Get(Config::GFX_EFB_SCALE) == 0)
+    return "strict-sync-needs-fixed-resolution";
+  if (!FindGameFile(m_current_game_identifier))
+    return "game-not-in-list";
+  if (!server->RequestStartGame())
+    return "start-refused";
+  SetOptionsEnabled(false);
+  return {};
+}
+
+std::string NetPlayDialog::ApplyNetcadeOptions(const picojson::object& options)
+{
+  const bool host_can_edit =
+      Settings::Instance().GetNetPlayServer() != nullptr && m_start_button->isEnabled();
+  const auto set_flag = [&options](const char* key, QAction* action) {
+    const auto it = options.find(key);
+    if (it != options.end() && it->second.is<bool>() && action->isEnabled())
+      action->setChecked(it->second.get<bool>());
+  };
+
+  // the one option every player has, as in the window
+  set_flag("recordInputs", m_record_input_action);
+  if (!host_can_edit)
+    return options.size() == 1 && options.contains("recordInputs") ? "" : "host-only-before-start";
+
+  const std::string savedata = GetString(options, "savedata");
+  if (savedata == "none")
+    m_savedata_none_action->setChecked(true);
+  else if (savedata == "load")
+    m_savedata_load_only_action->setChecked(true);
+  else if (savedata == "write")
+    m_savedata_load_and_write_action->setChecked(true);
+
+  const std::string network_mode = GetString(options, "networkMode");
+  if (network_mode == "fixeddelay")
+    m_fixed_delay_action->setChecked(true);
+  else if (network_mode == "hostinputauthority")
+    m_host_input_authority_action->setChecked(true);
+  else if (network_mode == "golf")
+    m_golf_mode_action->setChecked(true);
+
+  set_flag("syncAllWii", m_savedata_all_wii_saves_action);
+  set_flag("syncCodes", m_sync_codes_action);
+  set_flag("strictSync", m_strict_settings_sync_action);
+  set_flag("golfOverlay", m_golf_mode_overlay_action);
+  set_flag("hideRemoteGbas", m_hide_remote_gbas_action);
+  return {};
+}
+
+void NetPlayDialog::OnNetcadeCommand(const picojson::object& command)
+{
+  const auto client = Settings::Instance().GetNetPlayClient();
+  const auto server = Settings::Instance().GetNetPlayServer();
+  const std::string cmd = GetString(command, "cmd");
+  std::string error;
+
+  const auto find_pid = [&client](const std::string& name) -> NetPlay::PlayerId {
+    if (!client || name.empty())
+      return 0;
+    for (const NetPlay::Player* player : client->GetPlayers())
+    {
+      if (player->name == name)
+        return player->pid;
+    }
+    return 0;
+  };
+
+  if (cmd == "show")
+  {
+    QDialog::show();
+    raise();
+    activateWindow();
+  }
+  else if (cmd == "hide")
+  {
+    hide();
+  }
+  else if (cmd == "state")
+  {
+    // answered below
+  }
+  else if (cmd == "start")
+  {
+    const auto it = command.find("force");
+    error = NetcadeStartGame(it != command.end() && it->second.is<bool>() && it->second.get<bool>());
+  }
+  else if (cmd == "pads")
+  {
+    // ports: ["name on GC port 1", "port 2", "port 3", "port 4"], "" for an empty port
+    const auto it = command.find("ports");
+    if (!server)
+      error = "not-host";
+    else if (!m_start_button->isEnabled())
+      error = "game-running";
+    else if (it == command.end() || !it->second.is<picojson::array>())
+      error = "bad-ports";
+    else
+    {
+      NetPlay::PadMappingArray mapping{};
+      const auto& ports = it->second.get<picojson::array>();
+      for (std::size_t i = 0; i < mapping.size() && i < ports.size(); ++i)
+      {
+        if (ports[i].is<std::string>())
+          mapping[i] = find_pid(ports[i].get<std::string>());
+      }
+      server->SetPadMapping(mapping);
+    }
+  }
+  else if (cmd == "buffer")
+  {
+    const auto it = command.find("value");
+    if (it == command.end() || !it->second.is<double>())
+      error = "bad-value";
+    else if (!m_buffer_size_box->isEnabled())
+      error = "buffer-locked";
+    else
+      m_buffer_size_box->setValue(std::clamp(static_cast<int>(it->second.get<double>()), 0,
+                                             static_cast<int>(NetPlay::MAX_TARGET_PAD_BUFFER_SIZE)));
+  }
+  else if (cmd == "options")
+  {
+    const auto it = command.find("options");
+    if (it == command.end() || !it->second.is<picojson::object>())
+      error = "bad-options";
+    else
+      error = ApplyNetcadeOptions(it->second.get<picojson::object>());
+  }
+  else if (cmd == "recheck")
+  {
+    // makes every player look for the game again (e.g. after their game list finished loading)
+    if (!server)
+      error = "not-host";
+    else if (m_start_button->isEnabled() && !m_current_game_name.empty())
+      server->ChangeGame(m_current_game_identifier, m_current_game_name);
+  }
+  else if (cmd == "kick")
+  {
+    const NetPlay::PlayerId pid = find_pid(GetString(command, "name"));
+    if (!server)
+      error = "not-host";
+    else if (pid <= 1)
+      error = "no-such-player";
+    else
+      server->KickPlayer(pid);
+  }
+  else if (cmd == "chat")
+  {
+    const std::string text = GetString(command, "text");
+    if (!text.empty())
+      SendMessage(text);
+  }
+  else
+  {
+    error = "unknown-command";
+  }
+
+  picojson::object reply;
+  reply["ev"] = picojson::value("result");
+  reply["cmd"] = picojson::value(cmd);
+  reply["ok"] = picojson::value(error.empty());
+  if (!error.empty())
+    reply["error"] = picojson::value(error);
+  if (const auto id = command.find("id"); id != command.end())
+    reply["id"] = id->second;
+  m_netcade->Send(reply);
+  SendNetcadeState();
+}
