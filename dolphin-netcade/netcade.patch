+// Copyright 2026 Netcade contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinQt/NetPlay/NetcadeBridge.h"
+
+#include <utility>
+
+#include <SFML/Network/IpAddress.hpp>
+#include <SFML/Network/SocketSelector.hpp>
+#include <SFML/System/Time.hpp>
+
+#include "Common/Logging/Log.h"
+#include "Common/Thread.h"
+#include "Common/Version.h"
+
+NetcadeBridge::NetcadeBridge(u16 port, std::string token, CommandHandler on_command,
+                             StatusHandler on_status)
+    : m_port(port), m_token(std::move(token)), m_on_command(std::move(on_command)),
+      m_on_status(std::move(on_status))
+{
+  m_thread = std::thread([this] { Run(); });
+}
+
+NetcadeBridge::~NetcadeBridge()
+{
+  m_running = false;  // the reader wakes up at least every 200 ms to check this
+  if (m_thread.joinable())
+    m_thread.join();
+  std::lock_guard lock(m_send_mutex);
+  m_socket.disconnect();
+}
+
+void NetcadeBridge::Run()
+{
+  Common::SetCurrentThreadName("Netcade Bridge");
+
+  if (m_socket.connect(sf::IpAddress::LocalHost, m_port, sf::seconds(5)) != sf::Socket::Status::Done)
+  {
+    WARN_LOG_FMT(NETPLAY, "Netcade: could not reach the launcher on port {}", m_port);
+    m_on_status(false);
+    return;
+  }
+
+  m_connected = true;
+  picojson::object hello;
+  hello["ev"] = picojson::value("hello");
+  hello["token"] = picojson::value(m_token);
+  hello["version"] = picojson::value(Common::GetScmDescStr());
+  hello["protocol"] = picojson::value(1.0);
+  Send(hello);
+  m_on_status(true);
+
+  sf::SocketSelector selector;
+  selector.add(m_socket);
+  std::string buffer;
+  char chunk[4096];
+  while (m_running)
+  {
+    if (!selector.wait(sf::milliseconds(200)))
+      continue;
+    std::size_t received = 0;
+    if (m_socket.receive(chunk, sizeof(chunk), received) != sf::Socket::Status::Done)
+      break;
+    buffer.append(chunk, received);
+    if (buffer.size() > 1024 * 1024)  // a runaway line; Netcade never sends anything this big
+      break;
+
+    std::size_t newline;
+    while ((newline = buffer.find('\n')) != std::string::npos)
+    {
+      const std::string line = buffer.substr(0, newline);
+      buffer.erase(0, newline + 1);
+      if (line.empty())
+        continue;
+
+      picojson::value value;
+      const std::string error = picojson::parse(value, line);
+      if (!error.empty() || !value.is<picojson::object>())
+      {
+        WARN_LOG_FMT(NETPLAY, "Netcade: ignoring malformed command: {}", error);
+        continue;
+      }
+      m_on_command(value.get<picojson::object>());
+    }
+  }
+
+  m_connected = false;
+  if (m_running)
+  {
+    WARN_LOG_FMT(NETPLAY, "Netcade: lost the connection to the launcher");
+    m_on_status(false);
+  }
+}
+
+void NetcadeBridge::Send(const picojson::object& message)
+{
+  if (!m_connected)
+    return;
+  SendLine(picojson::value(message).serialize() + "\n");
+}
+
+bool NetcadeBridge::SendLine(const std::string& line)
+{
+  std::lock_guard lock(m_send_mutex);
+  std::size_t offset = 0;
+  while (offset < line.size())
+  {
+    std::size_t sent = 0;
+    const auto status = m_socket.send(line.data() + offset, line.size() - offset, sent);
+    offset += sent;
+    if (status == sf::Socket::Status::Partial)
+      continue;
+    if (status != sf::Socket::Status::Done)
+      return false;
+  }
+  return true;
+}
